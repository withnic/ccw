# Main loop
# --------------------------------------------------------------------------


class _Terminated(KeyboardInterrupt):
    """Raised from signal handlers so the Ctrl+C cleanup path runs."""


def _raise_terminated(signum: int, frame: object) -> None:
    raise _Terminated()


# Signals that end ccw through the same path as Ctrl+C. SIGHUP is sent when
# the terminal is closed (POSIX); SIGBREAK is Ctrl+Break (Windows).
TERMINATING_SIGNALS = ("SIGTERM", "SIGHUP", "SIGBREAK")

# Windows console control events that end the process and cannot be ignored.
CTRL_CLOSE_EVENT = 2
CTRL_LOGOFF_EVENT = 5
CTRL_SHUTDOWN_EVENT = 6
_CONSOLE_END_EVENTS = (CTRL_CLOSE_EVENT, CTRL_LOGOFF_EVENT, CTRL_SHUTDOWN_EVENT)


class _Cleanup:
    """Stops the child and removes the lock, at most once.

    Shared by the normal exit path and the Windows console handler, which
    runs on a separate thread.
    """

    def __init__(self, runner: ChildRunner) -> None:
        self.runner = runner
        self.lock_path: str | None = None
        self._guard = threading.Lock()
        self._done = False

    def run(self, wait_for_child: bool = True) -> None:
        with self._guard:
            if self._done:
                return
            self._done = True
        self.runner.terminate(wait=wait_for_child)
        release_lock(self.lock_path)


def _console_ctrl_handler(ctrl_type: int, cleanup: _Cleanup) -> bool:
    """Handle a Windows console control event; return True if handled.

    Closing the console window, logging off and shutting down cannot be
    caught as Python signals, and Windows kills the process a few seconds
    after this handler returns, so clean up right here without waiting for
    the child. Ctrl+C / Ctrl+Break are left to Python's own handlers.
    """
    if ctrl_type not in _CONSOLE_END_EVENTS:
        return False
    cleanup.run(wait_for_child=False)
    return True


def _install_console_handler(cleanup: _Cleanup) -> Callable[[], None] | None:
    try:
        import ctypes
        from ctypes import wintypes

        kernel32 = ctypes.WinDLL("kernel32", use_last_error=True)
    except (ImportError, OSError, AttributeError):
        return None
    handler_type = ctypes.WINFUNCTYPE(wintypes.BOOL, wintypes.DWORD)

    @handler_type
    def handler(ctrl_type: int) -> bool:
        try:
            return _console_ctrl_handler(int(ctrl_type), cleanup)
        except BaseException:
            return False

    set_handler = kernel32.SetConsoleCtrlHandler
    set_handler.argtypes = [handler_type, wintypes.BOOL]
    set_handler.restype = wintypes.BOOL
    if not set_handler(handler, True):
        return None

    def restore() -> None:
        set_handler(handler, False)  # the closure also keeps the callback alive

    return restore


def _install_handlers(cleanup: _Cleanup) -> Callable[[], None]:
    """Install termination handlers; return a function that restores them."""
    restores: list[Callable[[], None]] = []
    for name in TERMINATING_SIGNALS:
        signum = getattr(signal, name, None)
        if signum is None:
            continue
        try:
            previous = signal.signal(signum, _raise_terminated)
        except (ValueError, OSError):  # not in the main thread / unsupported
            continue
        if previous is None:
            previous = signal.SIG_DFL
        restores.append(lambda signum=signum, previous=previous: signal.signal(signum, previous))
    if os.name == "nt":
        restore_console = _install_console_handler(cleanup)
        if restore_console is not None:
            restores.append(restore_console)

    def restore_all() -> None:
        for restore in reversed(restores):
            with contextlib.suppress(ValueError, OSError, TypeError):
                restore()

    return restore_all


def _format_duration(seconds: float) -> str:
    total = round(seconds)
    hours, rem = divmod(total, 3600)
    minutes, secs = divmod(rem, 60)
    return f"{hours:d}h{minutes:02d}m{secs:02d}s"


def wait_until(
    target: datetime,
    now_fn: Callable[[], datetime],
    sleep_fn: Callable[[float], None],
    log: Callable[[str], None],
) -> None:
    """Sleep until wall-clock ``target`` (robust to system suspend)."""
    while True:
        remaining = (target - now_fn()).total_seconds()
        if remaining <= 0:
            return
        log(f"waiting for limit reset: {_format_duration(remaining)} remaining "
            f"(resume at {target.isoformat(timespec='seconds')})")
        sleep_fn(min(remaining, STATUS_INTERVAL_SEC))


def _wants_utf8(
    stream: TextIO,
    environ: Mapping[str, str] | None = None,
    is_windows: bool | None = None,
) -> bool:
    """Whether to force UTF-8 on ``stream``.

    On Windows, Python writes to pipes and files in the ANSI code page
    (cp932 on Japanese systems). Git Bash (mintty) reads its pipe as UTF-8,
    and cp932 cannot represent many characters claude prints (emoji, ...),
    so they would be garbled or lost. The real console is written with
    Unicode APIs regardless of encoding, so it is left alone, and an
    explicit PYTHONIOENCODING always wins.
    """
    if environ is None:
        environ = os.environ
    if is_windows is None:
        is_windows = os.name == "nt"
    if not is_windows or environ.get("PYTHONIOENCODING"):
        return False
    try:
        return not stream.isatty()
    except (AttributeError, ValueError, OSError):
        return False


def _prepare_stream(stream: TextIO) -> None:
    reconfigure = getattr(stream, "reconfigure", None)
    if reconfigure is None:
        return
    options = {"errors": "replace"}
    if _wants_utf8(stream):
        options["encoding"] = "utf-8"
    with contextlib.suppress(ValueError, OSError):
        reconfigure(**options)


def main(
    argv: Sequence[str] | None = None,
    *,
    claude_cmd: Sequence[str] | None = None,
    cwd: str | None = None,
    stdin: TextIO | None = None,
    stdout: TextIO | None = None,
    stderr: TextIO | None = None,
    now_fn: Callable[[], datetime] = datetime.now,
    sleep_fn: Callable[[float], None] = time.sleep,
) -> int:
    argv = sys.argv[1:] if argv is None else list(argv)
    stdin = sys.stdin if stdin is None else stdin
    stdout = sys.stdout if stdout is None else stdout
    stderr = sys.stderr if stderr is None else stderr
    _prepare_stream(stdout)
    _prepare_stream(stderr)
    cwd = os.getcwd() if cwd is None else cwd

    def log(message: str) -> None:
        stderr.write(f"[ccw] {message}\n")
        stderr.flush()

    # INIT -----------------------------------------------------------------
    try:
        opts = parse_options(argv, stdin)
    except UsageError as exc:
        log(f"error: {exc}")
        return EXIT_USAGE

    if claude_cmd is None:
        try:
            claude_cmd = resolve_claude_command()
        except ClaudeNotFoundError as exc:
            if not opts.dry_run:
                log(f"error: {exc}")
                return EXIT_USAGE
            log(f"warning: {exc}")
            claude_cmd = ["claude"]
    base_cmd = list(claude_cmd)

    runner = ChildRunner(stdout)
    cleanup = _Cleanup(runner)
    restore_handlers = _install_handlers(cleanup)
    try:
        try:
            cleanup.lock_path = acquire_lock(cwd)
        except LockError as exc:
            log(f"error: {exc}")
            return EXIT_LOCKED

        if opts.dry_run:
            log(f"dry run: lock acquired at {cleanup.lock_path}")
            log(f"dry run: would run {base_cmd + opts.initial_args('<prompt>')!r} "
                f"(prompt source: {opts.prompt_source})")
            log(f"dry run: resume with {base_cmd + opts.resume_args('<resume prompt>')!r}")
            return EXIT_OK

        retry_count = 0
        cmd = base_cmd + opts.initial_args()
        stdin_text = opts.initial_stdin
        while True:
            # RUNNING_INITIAL / RUNNING_RESUME --------------------------------
            try:
                rc, lines = runner.run(cmd, stdin_text)
            except OSError as exc:
                log(f"error: failed to start claude: {exc}")
                return EXIT_USAGE

            # EVALUATING_OUTPUT -----------------------------------------------
            if rc == EXIT_INTERRUPTED:
                # Ctrl+C / Ctrl+Break reached claude first; ccw's own handler
                # may not have run yet. Never resume after an interruption.
                log("interrupted")
                return EXIT_INTERRUPTED
            now = now_fn()
            info = detect_limit(list(lines), now)
            if not info.detected:
                if rc == 0:
                    return EXIT_OK
                log(f"claude exited with code {rc}")
                return rc

            log(f"session limit detected: {info.raw_line}")
            if retry_count >= opts.max_retries:
                log(f"giving up after {retry_count} wait cycle(s) (--max-retries {opts.max_retries})")
                return EXIT_MAX_RETRIES

            # WAITING_RESET ---------------------------------------------------
            seconds = compute_wait_seconds(info, now, opts.buffer_sec, opts.fallback_wait)
            if info.reset_at is None:
                log(f"reset time not found; using fallback wait of {opts.fallback_wait}s")
            wait_until(now + timedelta(seconds=seconds), now_fn, sleep_fn, log)

            retry_count += 1
            log(f"resuming session ({retry_count}/{opts.max_retries})")
            cmd = base_cmd + opts.resume_args()
            stdin_text = None
    except KeyboardInterrupt:
        log("interrupted")
        return EXIT_INTERRUPTED
    finally:
        # CLEANUP -------------------------------------------------------------
        cleanup.run()
        restore_handlers()


def _entry() -> int:
    """Script entry point: an interruption always exits with 130.

    A Ctrl+C / Ctrl+Break / SIGTERM can arrive late, e.g. after claude has
    already exited and ``main()`` is cleaning up or restoring its handlers.
    Keeping our handlers installed around ``main()`` turns such a signal into
    a KeyboardInterrupt caught here, instead of a traceback or a kill by the
    default handler.
    """
    for name in TERMINATING_SIGNALS:
        signum = getattr(signal, name, None)
        if signum is not None:
            with contextlib.suppress(ValueError, OSError):
                signal.signal(signum, _raise_terminated)
    try:
        return main()
    except KeyboardInterrupt:
        return EXIT_INTERRUPTED


if __name__ == "__main__":
    sys.exit(_entry())
